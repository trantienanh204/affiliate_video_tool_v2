# ============================================================
# Affiliate Video AI – Environment Variables
# Copy to .env and adjust. Prefix: AVA_
# ============================================================

# Render mode: cpu | gpu
AVA_RENDER_MODE=cpu

# Ollama
AVA_OLLAMA_BASE_URL=http://localhost:11434
AVA_OLLAMA_MODEL=qwen2.5:7b
AVA_OLLAMA_TIMEOUT=120

# ComfyUI (only needed for GPU mode)
AVA_COMFYUI_URL=http://127.0.0.1:8188
AVA_COMFYUI_ENABLED=false

# Video defaults
AVA_VIDEO_WIDTH=1080
AVA_VIDEO_HEIGHT=1920
AVA_VIDEO_FPS=24
AVA_DEFAULT_DURATION=35

# TTS
AVA_TTS_VOICE_DEFAULT=vi-VN-HoaiMyNeural

# Whisper / subtitle
AVA_WHISPER_MODEL=base
AVA_WHISPER_DEVICE=cpu
AVA_BURN_SUBTITLES=true

# BGM
AVA_ENABLE_BGM=true
AVA_BGM_VOLUME=0.18

# Gradio
AVA_GRADIO_SERVER_NAME=0.0.0.0
AVA_GRADIO_SERVER_PORT=7860
AVA_GRADIO_QUEUE=true

# Logging
AVA_LOG_LEVEL=INFO
AVA_LOG_FILE=logs/app.log

# Batch
AVA_MAX_BATCH_SIZE=100
AVA_PARALLEL_WORKERS=2
