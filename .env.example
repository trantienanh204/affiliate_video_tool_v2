# ============================================================
# Affiliate Video AI – Environment Variables
# Copy to .env and adjust. Prefix: AVA_
# ============================================================

# Render mode: cpu | gpu
# B2C mặc định CPU (chỉ backup Ken Burns khi AI yếu). Chỉ khi cấu hình gpu
# mới bắt buộc phải có AI video (và sẽ ném lỗi nếu AI không tạo được clip).
AVA_RENDER_MODE=cpu
AVA_REQUIRE_AI_VIDEO=false
# PO: video ván hàng / hoạt hình phải ít nhất 4 clip AI riêng.
AVA_I2V_MAX_SCENES=5
AVA_I2V_SCENE_DURATION=3

# Ollama
AVA_OLLAMA_BASE_URL=http://localhost:11434
AVA_OLLAMA_MODEL=qwen2.5:7b
AVA_OLLAMA_TIMEOUT=120

# ComfyUI (only needed for GPU mode)
AVA_COMFYUI_URL=http://127.0.0.1:8188
AVA_COMFYUI_ENABLED=true

# Hugging Face key for the ZeroGPU video/keyframe Spaces (HF_TOKEN, not FAL_KEY).
# A token may improve access but does not provide guaranteed free quota.
AVA_VIDEO_PROVIDER=hf_zerogpu
HF_TOKEN=
AVA_HF_CHARACTER_ENABLED=true
AVA_HF_CHARACTER_SPACE=hugging-apps/qwen-image-2-1
AVA_HF_CHARACTER_STEPS=10
# Optional fal.ai fallback. This needs a separate fal.ai key and may incur charges.
FAL_KEY=
AVA_VIDEO_PROVIDER_FALLBACKS=fal,comfyui
AVA_FAL_MODEL=fal-ai/wan/v2.7/image-to-video
AVA_FAL_VIDEO_DURATION=5
AVA_FAL_RESOLUTION=720p

# Video defaults
AVA_VIDEO_WIDTH=1080
AVA_VIDEO_HEIGHT=1920
AVA_VIDEO_FPS=24
AVA_DEFAULT_DURATION=35

# TTS
AVA_TTS_VOICE_DEFAULT=vi-VN-HoaiMyNeural

# Whisper / subtitle
AVA_WHISPER_MODEL=base
AVA_WHISPER_DEVICE=cpu
AVA_BURN_SUBTITLES=true

# BGM
AVA_ENABLE_BGM=true
AVA_BGM_VOLUME=0.18

# Gradio
AVA_GRADIO_SERVER_NAME=0.0.0.0
AVA_GRADIO_SERVER_PORT=7860
AVA_GRADIO_QUEUE=true

# Logging
AVA_LOG_LEVEL=INFO
AVA_LOG_FILE=logs/app.log

# Batch
AVA_MAX_BATCH_SIZE=100
AVA_PARALLEL_WORKERS=2
